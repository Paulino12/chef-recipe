{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "studio": "sanity dev --port 3333",
    "studio:build": "sanity build",
    "studio:deploy": "sanity deploy",
    "data:hospitality": "python scripts/generate_hospitality_dataset.py",
    "data:costing-analysis": "python scripts/analyze_recipe_costing.py",
    "data:ingredient-catalog": "python scripts/generate_ingredient_search_catalog.py",
    "data:costing-prototype": "python scripts/prototype_recipe_costs.py",
    "data:recipe-book-images": "python scripts/extract_recipe_book_images.py",
    "data:merge": "python scripts/merge_recipe_datasets.py",
    "data:image-shortlist": "python scripts/generate_ai_image_shortlist.py",
    "data:prepare": "node scripts/prepare-recipe-dataset.js",
    "data:import": "npm run data:prepare && npx sanity dataset import data/sanity_golden_samples_v3.ndjson production --replace",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "@portabletext/react": "^6.0.2",
    "@sanity/client": "^7.14.1",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^1.2.0",
    "@sanity/ui": "^3.1.11",
    "@sanity/vision": "^5.10.0",
    "@supabase/supabase-js": "^2.95.3",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.34.2",
    "next": "16.1.6",
    "next-sanity": "^12.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sanity": "^5.10.0",
    "stripe": "^20.3.1",
    "styled-components": "6.1.15"
  },
  "overrides": {
    "isomorphic-dompurify": "2.26.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
